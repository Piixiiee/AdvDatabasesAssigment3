###  http://www.semanticweb.org/frida/ontologies/2026/3/untitled-ontology-3/status
:status rdf:type owl:DatatypeProperty ;
        rdfs:domain :Registrations ;
        rdfs:range [ rdf:type rdfs:Datatype ;
                     owl:oneOf [ rdf:type rdf:List ;
                                 rdf:first "completed" ;
                                 rdf:rest [ rdf:type rdf:List ;
                                            rdf:first "not started" ;
                                            rdf:rest [ rdf:type rdf:List ;
                                                       rdf:first "registred" ;
                                                       rdf:rest [ rdf:type rdf:List ;
                                                                  rdf:first "withdrawn" ;
                                                                  rdf:rest rdf:nil
                                                                ]
                                                     ]
                                          ]
                               ]
                   ] .


