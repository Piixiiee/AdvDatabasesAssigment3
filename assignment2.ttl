###  http://www.semanticweb.org/frida/ontologies/2026/3/untitled-ontology-3/courseName
:courseName rdf:type owl:DatatypeProperty ;
            rdfs:domain :Course ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/frida/ontologies/2026/3/untitled-ontology-3/courseType
:courseType rdf:type owl:DatatypeProperty ;
            rdfs:domain :Programme_Course ;
            rdfs:range [ rdf:type rdfs:Datatype ;
                         owl:oneOf [ rdf:type rdf:List ;
                                     rdf:first "compulsory" ;
                                     rdf:rest [ rdf:type rdf:List ;
                                                rdf:first "compulsory-elective" ;
                                                rdf:rest [ rdf:type rdf:List ;
                                                           rdf:first "elective" ;
                                                           rdf:rest rdf:nil
                                                         ]
                                              ]
                                   ]
                       ] .


###  http://www.semanticweb.org/frida/ontologies/2026/3/untitled-ontology-3/credits
:credits rdf:type owl:DatatypeProperty ;
         rdfs:domain :Course ;
         rdfs:range xsd:decimal .


###  http://www.semanticweb.org/frida/ontologies/2026/3/untitled-ontology-3/grade
:grade rdf:type owl:DatatypeProperty ;
       rdfs:domain :Registrations ;
       rdfs:range [ rdf:type rdfs:Datatype ;
                    owl:oneOf [ rdf:type rdf:List ;
                                rdf:first 3 ;
                                rdf:rest [ rdf:type rdf:List ;
                                           rdf:first 4 ;
                                           rdf:rest [ rdf:type rdf:List ;
                                                      rdf:first 5 ;
                                                      rdf:rest rdf:nil
                                                    ]
                                         ]
                              ]
                  ] .


